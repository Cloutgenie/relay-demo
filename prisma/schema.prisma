generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  workspaceName      String   @default("Default workspace")
  sprinklrEnv        String   @default("mock")
  oauthConnected     Boolean  @default(false)
  oauthConnectedAt   DateTime?
  oauthClientId      String?
  webhookSecret      String
  webhookUrl         String?
  autoWriteThreshold Float    @default(0.82)
  reviewThreshold    Float    @default(0.40)
  listeningEnabled   Boolean  @default(false)
  writebackEnabled    Boolean  @default(true)
  caseCreatedHook     Boolean  @default(false)
  connectCompletedAt  DateTime?
  capabilityReport    Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users     User[]
  fieldMaps FieldMap[]
  rules     Rule[]
  terms     TaxonomyTerm[]
  messages  Message[]
  reviews   ReviewItem[]
  audits    AuditEvent[]
  writeJobs WriteJob[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model FieldMap {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tagType         String
  entityType      String
  fieldName       String
  sprinklrFieldId String?
  existsInTenant  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, tagType, entityType])
}

model TaxonomyTerm {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tagType   String
  slug      String
  label     String
  keywords  String[]
  createdAt DateTime @default(now())

  @@unique([tenantId, tagType, slug])
  @@index([tenantId, tagType])
}

model Rule {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  enabled       Boolean  @default(true)
  priority      Int      @default(100)
  tagType       String
  tagValue      String
  matchType     String
  pattern       String
  caseSensitive Boolean  @default(false)
  source        String   @default("manual")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, enabled, priority])
}

model Message {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprinklrMessageId    String
  entityType           String   @default("Message")
  text                 String
  channel              String
  account              String
  author               String
  existingFields       Json     @default("{}")
  rawPayload           Json     @default("{}")
  status               String   @default("ingested")
  category             String?
  brand                String?
  campaign             String?
  categoryConfidence   Float?
  brandConfidence      Float?
  campaignConfidence   Float?
  classificationSource String?
  writtenBack          Boolean  @default(false)
  writtenAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  review    ReviewItem?
  audits    AuditEvent[]
  writeJobs WriteJob[]

  @@unique([tenantId, sprinklrMessageId])
  @@index([tenantId, status, createdAt])
}

model ReviewItem {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId          String    @unique
  message            Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status             String    @default("pending")
  suggestedCategory  String?
  suggestedBrand     String?
  suggestedCampaign  String?
  finalCategory      String?
  finalBrand         String?
  finalCampaign      String?
  reviewerEmail      String?
  reviewedAt         DateTime?
  note               String?
  createdAt          DateTime  @default(now())

  @@index([tenantId, status, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId  String?
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  action     String
  actor      String
  source     String
  confidence Float?
  before     Json     @default("{}")
  after      Json     @default("{}")
  detail     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model WriteJob {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status      String    @default("queued")
  payload     Json
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, status, scheduledAt])
}
