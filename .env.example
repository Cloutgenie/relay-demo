SPRINKLR_OAUTH_TOKEN_URL="https://prod0-login.sprinklr.com/oauth/token"
SPRINKLR_CLIENT_ID=""
SPRINKLR_CLIENT_SECRET=""
SPRINKLR_REDIRECT_URI="http://localhost:43147/api/oauth/sprinklr/callback"
SPRINKLR_API_KEY=""

# Feature flags
LISTENING_API_ENABLED="false"
